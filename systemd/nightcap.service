[Unit]
Description=nightcap Discord service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=nightcap
Group=nightcap
WorkingDirectory=/opt/nightcap
EnvironmentFile=/etc/nightcap.env
ExecStart=/usr/bin/node --enable-source-maps dist/main.js
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
